MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_TIMEOUT_SECONDS=3

MQTT_HOST=192.168.1.200
MQTT_PORT=1883
MQTT_CLIENT_ID=anker-gateway
MQTT_TOPIC_PREFIX=anker
MQTT_QOS=1
MQTT_RETAIN=true

# Optional MQTT authorization
# If you set MQTT_USERNAME, you must also set MQTT_PASSWORD.
MQTT_USERNAME=
MQTT_PASSWORD=

POLL_INTERVAL_SECONDS=1
RECONNECT_DELAY_SECONDS=2
